# Copy this file to `Java/deep_bark/secrets/application-local.properties`
# and fill in your local-only secrets before running the backend.

DB_PASSWORD=replace-with-your-db-password
JWT_SECRET=replace-with-base64-encoded-jwt-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
FLASK_SERVER_URL=http://localhost:5000
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
PASSWORD_RESET_BASE_URL=http://localhost:8080
PASSWORD_RESET_EXPIRATION=1800000
